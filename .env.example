# Token de autenticación del bot de Telegram
BOT_TOKEN=

# Configuración de Google Gemini IA
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Opcional: IDs de Telegram permitidos separados por coma (ej: 12345678,87654321).
# Si se deja vacío, el bot responde a cualquier usuario.
USUARIOS_PERMITIDOS=
