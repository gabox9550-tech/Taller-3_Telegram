{
  "name": "taller-compartir",
  "version": "1.0.0",
  "description": "Taller: bot de Telegram que invoca un .exe y scripts de Python, y maneja documentos e imagenes",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "node index.js",
    "start:permisos": "node --permission --allow-fs-read=./* --allow-fs-write=./datos/* --allow-child-process index.js"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "form-data": "^4.0.6",
    "telegraf": "^4.16.3"
  },
  "engines": {
    "node": ">=18"
  }
}
